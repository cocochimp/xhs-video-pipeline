 "lines": [
  {
   "scene": "s01",
   "i": 0,
   "seg": "open",
   "zh": "普通人，要如何才能【提前退休】？",
   "start": 0.345,
   "end": 1.765
  },
  {
   "scene": "s01",
   "i": 1,
   "seg": "open",
   "zh": "这里是阿牛退休计划，第1期",
   "start": 2.076,
   "end": 3.315
  },
  {
   "scene": "s02",
   "i": 0,
   "seg": "open",
   "zh": "本期我们要讲的是：",
   "start": 3.689,
   "end": 4.575
  },
  {
   "scene": "s02",
   "i": 1,
   "seg": "title",
   "zh": "月薪8千，想退休到底要攒多少钱？",
   "start": 7.23,
   "end": 9.33
  },
  {
   "scene": "s03",
   "i": 0,
   "seg": "body",
   "zh": "加班到十点，工资一到账就【没了】",
   "start": 10.08,
   "end": 12.375
  },
  {
   "scene": "s03",
   "i": 1,
   "seg": "body",
   "zh": "谁没想过，干脆不干了？",
   "start": 12.841,
   "end": 14.085
  },
  {
   "scene": "s03",
   "i": 2,
   "seg": "body",
   "zh": "可真不上班，要攒多少钱才够？",
   "start": 14.527,
   "end": 16.845
  },
  {
   "scene": "s04",
   "i": 0,
   "seg": "body",
   "zh": "先别盯着工资，看你【花多少】",
   "start": 17.31,
   "end": 19.125
  },
  {
   "scene": "s04",
   "i": 1,
   "seg": "body",
   "zh": "赚多少，决定你攒得快不快",
   "start": 19.601,
   "end": 21.125
  },
  {
   "scene": "s04",
   "i": 2,
   "seg": "body",
   "zh": "花多少，才决定你要攒【多少】",
   "start": 21.592,
   "end": 23.505
  },
  {
   "scene": "s05",
   "i": 0,
   "seg": "body",
   "zh": "有个常用算法，叫【4%法则】",
   "start": 23.906,
   "end": 25.885
  },
  {
   "scene": "s05",
   "i": 1,
   "seg": "body",
   "zh": "每年只花存款的4%，钱大概率花不完",
   "start": 26.422,
   "end": 28.965
  },
  {
   "scene": "s05",
   "i": 2,
   "seg": "body",
   "zh": "反过来，一年花多少，【乘以25】",
   "start": 29.33,
   "end": 31.285
  },
  {
   "scene": "s05",
   "i": 3,
   "seg": "body",
   "zh": "就是你的【退休数字】",
   "start": 31.713,
   "end": 32.165
  },
  {
   "scene": "s06",
   "i": 0,
   "seg": "body",
   "zh": "月薪8千，每月花5千，一年6万",
   "start": 32.939,
   "end": 35.505
  },
  {
   "scene": "s06",
   "i": 1,
   "seg": "body",
   "zh": "乘以25",
   "start": 35.938,
   "end": 36.505
  },
  {
   "scene": "s06",
   "i": 2,
   "seg": "body",
   "zh": "【150万】",
   "start": 36.877,
   "end": 37.415
  },
  {
   "scene": "s07",
   "i": 0,
   "seg": "body",
   "zh": "听着很吓人？",
   "start": 37.77,
   "end": 38.385
  },
  {
   "scene": "s07",
   "i": 1,
   "seg": "body",
   "zh": "别急，这个公式里，支出就是【放大器】",
   "start": 38.81,
   "end": 41.075
  },
  {
   "scene": "s07",
   "i": 2,
   "seg": "body",
   "zh": "每月少花1块，目标就少【25块】",
   "start": 41.622,
   "end": 44.025
  },
  {
   "scene": "s08",
   "i": 0,
   "seg": "body",
   "zh": "所以省钱别光盯着奶茶",
   "start": 44.428,
   "end": 45.955
  },
  {
   "scene": "s08",
   "i": 1,
   "seg": "body",
   "zh": "先砍【固定大头】：房租、分期、自动续费",
   "start": 46.337,
   "end": 49.414
  },
  {
   "scene": "s08",
   "i": 2,
   "seg": "body",
   "zh": "砍一次，以后每个月都在省",
   "start": 49.836,
   "end": 51.615
  },
  {
   "scene": "s09",
   "i": 0,
   "seg": "body",
   "zh": "目标很远，也不用一步到位",
   "start": 52.326,
   "end": 53.835
  },
  {
   "scene": "s09",
   "i": 1,
   "seg": "body",
   "zh": "每攒够一年的花销，就多【一年底气】",
   "start": 54.31,
   "end": 56.465
  },
  {
   "scene": "s09",
   "i": 2,
   "seg": "body",
   "zh": "被裁、跳槽空档，都能扛住",
   "start": 56.883,
   "end": 59.125
  },
  {
   "scene": "s10",
   "i": 0,
   "seg": "body",
   "zh": "所以第一步不是赚更多，而是先【算清楚】",
   "start": 59.53,
   "end": 61.725
  },
  {
   "scene": "s10",
   "i": 1,
   "seg": "body",
   "zh": "这个月起，把每笔花销记下来",
   "start": 62.35,
   "end": 64.415
  },
  {
   "scene": "s10",
   "i": 2,
   "seg": "body",
   "zh": "月底算出总数，再乘以25",
   "start": 64.804,
   "end": 66.525
  },
  {
   "scene": "s11",
   "i": 0,
   "seg": "end",
   "zh": "评论区说说，你的【退休数字】是多少",
   "start": 67.375,
   "end": 69.28
  },
  {
   "scene": "s11",
   "i": 1,
   "seg": "end",
   "zh": "关注阿牛，一起【早日退休】！",
   "start": 69.655,
   "end": 70.97
  }
 ],
