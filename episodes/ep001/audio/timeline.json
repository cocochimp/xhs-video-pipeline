 "lines": [
  {
   "scene": "s01",
   "i": 0,
   "seg": "open",
   "zh": "普通人，要如何才能【提前退休】？",
   "start": 0.345,
   "end": 1.765
  },
  {
   "scene": "s01",
   "i": 1,
   "seg": "open",
   "zh": "这里是阿牛退休计划，第1期",
   "start": 2.076,
   "end": 3.315
  },
  {
   "scene": "s02",
   "i": 0,
   "seg": "open",
   "zh": "本期我们要讲的是：",
   "start": 3.689,
   "end": 4.575
  },
  {
   "scene": "s02",
   "i": 1,
   "seg": "title",
   "zh": "月薪8千，想退休到底要攒多少钱？",
   "start": 7.23,
   "end": 9.33
  },
  {
   "scene": "s03",
   "i": 0,
   "seg": "body",
   "zh": "到手【8000】，每月花【5000】",
   "start": 10.08,
   "end": 11.885
  },
  {
   "scene": "s03",
   "i": 1,
   "seg": "body",
   "zh": "想不上班也有钱花",
   "start": 12.36,
   "end": 13.335
  },
  {
   "scene": "s03",
   "i": 2,
   "seg": "body",
   "zh": "到底要攒多少？",
   "start": 13.918,
   "end": 14.615
  },
  {
   "scene": "s04",
   "i": 0,
   "seg": "body",
   "zh": "有个简单的算法，叫【4%法则】",
   "start": 15.072,
   "end": 16.955
  },
  {
   "scene": "s04",
   "i": 1,
   "seg": "body",
   "zh": "每年只花存款的【4%】",
   "start": 17.551,
   "end": 18.795
  },
  {
   "scene": "s04",
   "i": 2,
   "seg": "body",
   "zh": "钱基本就花不完",
   "start": 19.104,
   "end": 19.855
  },
  {
   "scene": "s05",
   "i": 0,
   "seg": "body",
   "zh": "反过来算",
   "start": 20.236,
   "end": 20.525
  },
  {
   "scene": "s05",
   "i": 1,
   "seg": "body",
   "zh": "一年花多少，【乘以25】",
   "start": 20.525,
   "end": 21.185
  },
  {
   "scene": "s05",
   "i": 2,
   "seg": "body",
   "zh": "就是你的【退休数字】",
   "start": 21.185,
   "end": 23.075
  },
  {
   "scene": "s06",
   "i": 0,
   "seg": "body",
   "zh": "每月5000，一年【6万】",
   "start": 24.073,
   "end": 25.265
  },
  {
   "scene": "s06",
   "i": 1,
   "seg": "body",
   "zh": "再乘以25",
   "start": 25.677,
   "end": 26.265
  },
  {
   "scene": "s06",
   "i": 2,
   "seg": "body",
   "zh": "【150万】",
   "start": 26.457,
   "end": 26.945
  },
  {
   "scene": "s07",
   "i": 0,
   "seg": "body",
   "zh": "很吓人？",
   "start": 27.352,
   "end": 27.745
  },
  {
   "scene": "s07",
   "i": 1,
   "seg": "body",
   "zh": "别急，这个公式藏着一个【好消息】",
   "start": 28.172,
   "end": 29.865
  },
  {
   "scene": "s07",
   "i": 2,
   "seg": "body",
   "zh": "花得越少，要攒的就【越少】",
   "start": 30.427,
   "end": 31.765
  },
  {
   "scene": "s08",
   "i": 0,
   "seg": "body",
   "zh": "每月少花【1000】",
   "start": 32.195,
   "end": 32.865
  },
  {
   "scene": "s08",
   "i": 1,
   "seg": "body",
   "zh": "目标直接少【30万】",
   "start": 33.148,
   "end": 33.895
  },
  {
   "scene": "s09",
   "i": 0,
   "seg": "body",
   "zh": "所以第一步不是赚更多",
   "start": 34.411,
   "end": 35.575
  },
  {
   "scene": "s09",
   "i": 1,
   "seg": "body",
   "zh": "而是先【算清楚】",
   "start": 35.898,
   "end": 36.395
  },
  {
   "scene": "s09",
   "i": 2,
   "seg": "body",
   "zh": "你一个月到底花多少钱",
   "start": 36.942,
   "end": 38.035
  },
  {
   "scene": "s10",
   "i": 0,
   "seg": "end",
   "zh": "你每月花多少？",
   "start": 38.885,
   "end": 39.73
  },
  {
   "scene": "s10",
   "i": 1,
   "seg": "end",
   "zh": "评论区算算你的【退休数字】",
   "start": 40.105,
   "end": 41.21
  },
  {
   "scene": "s10",
   "i": 2,
   "seg": "end",
   "zh": "关注阿牛",
   "start": 41.605,
   "end": 42.04
  },
  {
   "scene": "s10",
   "i": 3,
   "seg": "end",
   "zh": "一起【早日退休】！",
   "start": 42.227,
   "end": 42.8
  }
 ],
