 "lines": [
  {
   "scene": "s01",
   "i": 0,
   "seg": "open",
   "zh": "普通人，要如何才能【提前退休】？",
   "start": 0.3,
   "end": 1.835
  },
  {
   "scene": "s01",
   "i": 1,
   "seg": "open",
   "zh": "这里是阿牛退休计划，第1期",
   "start": 2.242,
   "end": 3.585
  },
  {
   "scene": "s02",
   "i": 0,
   "seg": "open",
   "zh": "本期我们要讲的是：",
   "start": 4.055,
   "end": 4.885
  },
  {
   "scene": "s02",
   "i": 1,
   "seg": "title",
   "zh": "月薪8千，想退休到底要攒多少钱？",
   "start": 7.53,
   "end": 9.65
  },
  {
   "scene": "s03",
   "i": 0,
   "seg": "body",
   "zh": "到手【8000】，每月花【5000】",
   "start": 10.4,
   "end": 12.015
  },
  {
   "scene": "s03",
   "i": 1,
   "seg": "body",
   "zh": "想不上班也有钱花",
   "start": 12.44,
   "end": 13.405
  },
  {
   "scene": "s03",
   "i": 2,
   "seg": "body",
   "zh": "到底要攒多少？",
   "start": 13.801,
   "end": 14.465
  },
  {
   "scene": "s04",
   "i": 0,
   "seg": "body",
   "zh": "有个简单的算法，叫【4%法则】",
   "start": 14.882,
   "end": 16.955
  },
  {
   "scene": "s04",
   "i": 1,
   "seg": "body",
   "zh": "每年只花存款的【4%】",
   "start": 17.53,
   "end": 18.815
  },
  {
   "scene": "s04",
   "i": 2,
   "seg": "body",
   "zh": "钱基本就花不完",
   "start": 19.128,
   "end": 19.755
  },
  {
   "scene": "s05",
   "i": 0,
   "seg": "body",
   "zh": "反过来算",
   "start": 20.366,
   "end": 20.785
  },
  {
   "scene": "s05",
   "i": 1,
   "seg": "body",
   "zh": "一年花多少，【乘以25】",
   "start": 21.292,
   "end": 22.635
  },
  {
   "scene": "s05",
   "i": 2,
   "seg": "body",
   "zh": "就是你的【退休数字】",
   "start": 22.913,
   "end": 23.735
  },
  {
   "scene": "s06",
   "i": 0,
   "seg": "body",
   "zh": "每月5000，一年【6万】",
   "start": 24.163,
   "end": 25.325
  },
  {
   "scene": "s06",
   "i": 1,
   "seg": "body",
   "zh": "再乘以25",
   "start": 25.673,
   "end": 26.315
  },
  {
   "scene": "s06",
   "i": 2,
   "seg": "body",
   "zh": "【150万】",
   "start": 26.633,
   "end": 27.155
  },
  {
   "scene": "s07",
   "i": 0,
   "seg": "body",
   "zh": "很吓人？",
   "start": 27.538,
   "end": 27.915
  },
  {
   "scene": "s07",
   "i": 1,
   "seg": "body",
   "zh": "别急，这个公式藏着一个【好消息】",
   "start": 28.357,
   "end": 30.035
  },
  {
   "scene": "s07",
   "i": 2,
   "seg": "body",
   "zh": "花得越少，要攒的就【越少】",
   "start": 30.588,
   "end": 31.985
  },
  {
   "scene": "s08",
   "i": 0,
   "seg": "body",
   "zh": "每月少花【1000】",
   "start": 32.37,
   "end": 33.005
  },
  {
   "scene": "s08",
   "i": 1,
   "seg": "body",
   "zh": "目标直接少【30万】",
   "start": 33.291,
   "end": 34.175
  },
  {
   "scene": "s09",
   "i": 0,
   "seg": "body",
   "zh": "所以第一步不是赚更多",
   "start": 34.601,
   "end": 35.815
  },
  {
   "scene": "s09",
   "i": 1,
   "seg": "body",
   "zh": "而是先【算清楚】",
   "start": 36.129,
   "end": 36.625
  },
  {
   "scene": "s09",
   "i": 2,
   "seg": "body",
   "zh": "你一个月到底花多少钱",
   "start": 36.625,
   "end": 37.815
  },
  {
   "scene": "s10",
   "i": 0,
   "seg": "end",
   "zh": "你每月花多少？",
   "start": 38.665,
   "end": 39.54
  },
  {
   "scene": "s10",
   "i": 1,
   "seg": "end",
   "zh": "评论区算算你的【退休数字】",
   "start": 39.945,
   "end": 41.27
  },
  {
   "scene": "s10",
   "i": 2,
   "seg": "end",
   "zh": "关注阿牛",
   "start": 41.605,
   "end": 42.02
  },
  {
   "scene": "s10",
   "i": 3,
   "seg": "end",
   "zh": "一起【早日退休】！",
   "start": 42.213,
   "end": 42.941
  }
 ],
