 "lines": [
  {
   "scene": "s01",
   "i": 0,
   "seg": "open",
   "zh": "普通人，要如何才能【提前退休】？",
   "start": 0.3,
   "end": 1.645
  },
  {
   "scene": "s01",
   "i": 1,
   "seg": "open",
   "zh": "这里是阿牛退休计划，第1期",
   "start": 1.996,
   "end": 3.325
  },
  {
   "scene": "s02",
   "i": 0,
   "seg": "open",
   "zh": "本期我们要讲的是：",
   "start": 3.783,
   "end": 4.575
  },
  {
   "scene": "s02",
   "i": 1,
   "seg": "title",
   "zh": "月薪8千，想退休到底要攒多少钱？",
   "start": 7.22,
   "end": 9.77
  },
  {
   "scene": "s03",
   "i": 0,
   "seg": "body",
   "zh": "到手【8000】，每月花【5000】",
   "start": 10.52,
   "end": 12.525
  },
  {
   "scene": "s03",
   "i": 1,
   "seg": "body",
   "zh": "想不上班也有钱花",
   "start": 13.0,
   "end": 14.175
  },
  {
   "scene": "s03",
   "i": 2,
   "seg": "body",
   "zh": "到底要攒多少？",
   "start": 14.709,
   "end": 15.515
  },
  {
   "scene": "s04",
   "i": 0,
   "seg": "body",
   "zh": "有个简单的算法，叫【4%法则】",
   "start": 16.066,
   "end": 18.065
  },
  {
   "scene": "s04",
   "i": 1,
   "seg": "body",
   "zh": "每年只花存款的【4%】",
   "start": 18.756,
   "end": 20.155
  },
  {
   "scene": "s04",
   "i": 2,
   "seg": "body",
   "zh": "钱基本就花不完",
   "start": 20.531,
   "end": 21.415
  },
  {
   "scene": "s05",
   "i": 0,
   "seg": "body",
   "zh": "反过来算",
   "start": 21.98,
   "end": 22.405
  },
  {
   "scene": "s05",
   "i": 1,
   "seg": "body",
   "zh": "一年花多少，【乘以25】",
   "start": 22.977,
   "end": 24.435
  },
  {
   "scene": "s05",
   "i": 2,
   "seg": "body",
   "zh": "就是你的【退休数字】",
   "start": 24.769,
   "end": 25.715
  },
  {
   "scene": "s06",
   "i": 0,
   "seg": "body",
   "zh": "每月5000，一年【6万】",
   "start": 26.236,
   "end": 27.625
  },
  {
   "scene": "s06",
   "i": 1,
   "seg": "body",
   "zh": "再乘以25",
   "start": 28.067,
   "end": 28.775
  },
  {
   "scene": "s06",
   "i": 2,
   "seg": "body",
   "zh": "【150万】",
   "start": 29.122,
   "end": 29.555
  },
  {
   "scene": "s07",
   "i": 0,
   "seg": "body",
   "zh": "很吓人？",
   "start": 30.206,
   "end": 30.206
  },
  {
   "scene": "s07",
   "i": 1,
   "seg": "body",
   "zh": "别急，这个公式藏着一个【好消息】",
   "start": 31.073,
   "end": 32.905
  },
  {
   "scene": "s07",
   "i": 2,
   "seg": "body",
   "zh": "花得越少，要攒的就【越少】",
   "start": 33.557,
   "end": 35.175
  },
  {
   "scene": "s08",
   "i": 0,
   "seg": "body",
   "zh": "每月少花【1000】",
   "start": 35.735,
   "end": 36.495
  },
  {
   "scene": "s08",
   "i": 1,
   "seg": "body",
   "zh": "目标直接少【30万】",
   "start": 36.806,
   "end": 37.815
  },
  {
   "scene": "s09",
   "i": 0,
   "seg": "body",
   "zh": "所以第一步不是赚更多",
   "start": 38.319,
   "end": 39.615
  },
  {
   "scene": "s09",
   "i": 1,
   "seg": "body",
   "zh": "而是先【算清楚】",
   "start": 39.952,
   "end": 40.545
  },
  {
   "scene": "s09",
   "i": 2,
   "seg": "body",
   "zh": "你一个月到底花多少钱",
   "start": 41.147,
   "end": 42.515
  },
  {
   "scene": "s10",
   "i": 0,
   "seg": "end",
   "zh": "你每月花多少？",
   "start": 43.365,
   "end": 44.2
  },
  {
   "scene": "s10",
   "i": 1,
   "seg": "end",
   "zh": "评论区算算你的【退休数字】",
   "start": 44.605,
   "end": 45.74
  },
  {
   "scene": "s10",
   "i": 2,
   "seg": "end",
   "zh": "关注阿牛",
   "start": 46.145,
   "end": 46.64
  },
  {
   "scene": "s10",
   "i": 3,
   "seg": "end",
   "zh": "一起【早日退休】！",
   "start": 46.811,
   "end": 47.49
  }
 ],
