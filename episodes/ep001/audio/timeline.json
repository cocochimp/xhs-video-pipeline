 "lines": [
  {
   "scene": "s01",
   "i": 0,
   "seg": "open",
   "zh": "普通人，要如何才能【提前退休】？",
   "start": 0.3,
   "end": 1.835
  },
  {
   "scene": "s01",
   "i": 1,
   "seg": "open",
   "zh": "这里是阿牛退休计划，第1期",
   "start": 2.242,
   "end": 3.585
  },
  {
   "scene": "s02",
   "i": 0,
   "seg": "open",
   "zh": "本期我们要讲的是：",
   "start": 4.055,
   "end": 4.885
  },
  {
   "scene": "s02",
   "i": 1,
   "seg": "title",
   "zh": "月薪8千，想退休到底要攒多少钱？",
   "start": 7.53,
   "end": 10.82
  },
  {
   "scene": "s03",
   "i": 0,
   "seg": "body",
   "zh": "到手【8000】，每月花【5000】",
   "start": 11.57,
   "end": 13.185
  },
  {
   "scene": "s03",
   "i": 1,
   "seg": "body",
   "zh": "想不上班也有钱花",
   "start": 13.61,
   "end": 14.575
  },
  {
   "scene": "s03",
   "i": 2,
   "seg": "body",
   "zh": "到底要攒多少？",
   "start": 14.971,
   "end": 15.635
  },
  {
   "scene": "s04",
   "i": 0,
   "seg": "body",
   "zh": "有个简单的算法，叫【4%法则】",
   "start": 16.052,
   "end": 18.125
  },
  {
   "scene": "s04",
   "i": 1,
   "seg": "body",
   "zh": "每年只花存款的【4%】",
   "start": 18.7,
   "end": 19.985
  },
  {
   "scene": "s04",
   "i": 2,
   "seg": "body",
   "zh": "钱基本就花不完",
   "start": 20.298,
   "end": 20.925
  },
  {
   "scene": "s05",
   "i": 0,
   "seg": "body",
   "zh": "反过来算",
   "start": 21.536,
   "end": 21.955
  },
  {
   "scene": "s05",
   "i": 1,
   "seg": "body",
   "zh": "一年花多少，【乘以25】",
   "start": 22.462,
   "end": 23.805
  },
  {
   "scene": "s05",
   "i": 2,
   "seg": "body",
   "zh": "就是你的【退休数字】",
   "start": 24.083,
   "end": 24.905
  },
  {
   "scene": "s06",
   "i": 0,
   "seg": "body",
   "zh": "每月5000，一年【6万】",
   "start": 25.333,
   "end": 26.495
  },
  {
   "scene": "s06",
   "i": 1,
   "seg": "body",
   "zh": "再乘以25",
   "start": 26.843,
   "end": 27.485
  },
  {
   "scene": "s06",
   "i": 2,
   "seg": "body",
   "zh": "【150万】",
   "start": 27.803,
   "end": 28.325
  },
  {
   "scene": "s07",
   "i": 0,
   "seg": "body",
   "zh": "很吓人？",
   "start": 28.708,
   "end": 29.085
  },
  {
   "scene": "s07",
   "i": 1,
   "seg": "body",
   "zh": "别急，这个公式藏着一个【好消息】",
   "start": 29.527,
   "end": 31.205
  },
  {
   "scene": "s07",
   "i": 2,
   "seg": "body",
   "zh": "花得越少，要攒的就【越少】",
   "start": 31.758,
   "end": 33.155
  },
  {
   "scene": "s08",
   "i": 0,
   "seg": "body",
   "zh": "每月少花【1000】",
   "start": 33.54,
   "end": 34.175
  },
  {
   "scene": "s08",
   "i": 1,
   "seg": "body",
   "zh": "目标直接少【30万】",
   "start": 34.461,
   "end": 35.345
  },
  {
   "scene": "s09",
   "i": 0,
   "seg": "body",
   "zh": "所以第一步不是赚更多",
   "start": 35.771,
   "end": 36.985
  },
  {
   "scene": "s09",
   "i": 1,
   "seg": "body",
   "zh": "而是先【算清楚】",
   "start": 37.299,
   "end": 37.795
  },
  {
   "scene": "s09",
   "i": 2,
   "seg": "body",
   "zh": "你一个月到底花多少钱",
   "start": 37.795,
   "end": 38.985
  },
  {
   "scene": "s10",
   "i": 0,
   "seg": "end",
   "zh": "你每月花多少？",
   "start": 39.835,
   "end": 40.71
  },
  {
   "scene": "s10",
   "i": 1,
   "seg": "end",
   "zh": "评论区算算你的【退休数字】",
   "start": 41.115,
   "end": 42.44
  },
  {
   "scene": "s10",
   "i": 2,
   "seg": "end",
   "zh": "关注阿牛",
   "start": 42.776,
   "end": 43.191
  },
  {
   "scene": "s10",
   "i": 3,
   "seg": "end",
   "zh": "一起【早日退休】！",
   "start": 43.383,
   "end": 44.111
  }
 ],
