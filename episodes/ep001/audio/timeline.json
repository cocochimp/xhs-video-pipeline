 "lines": [
  {
   "scene": "s01",
   "i": 0,
   "seg": "hook",
   "zh": "普通人，要如何才能【提前退休】？",
   "start": 0.465,
   "end": 2.895
  },
  {
   "scene": "s01",
   "i": 1,
   "seg": "open",
   "zh": "这里是阿牛退休计划，第1期",
   "start": 3.445,
   "end": 5.41
  },
  {
   "scene": "s02",
   "i": 0,
   "seg": "open",
   "zh": "本期我们要讲的是：",
   "start": 5.983,
   "end": 6.85
  },
  {
   "scene": "s02",
   "i": 1,
   "seg": "title",
   "zh": "月薪8千，想退休到底要攒多少钱？",
   "start": 8.545,
   "end": 11.695
  },
  {
   "scene": "s03",
   "i": 0,
   "seg": "body",
   "zh": "到手【8000】，每月花【5000】",
   "start": 12.445,
   "end": 14.45
  },
  {
   "scene": "s03",
   "i": 1,
   "seg": "body",
   "zh": "想不上班也有钱花",
   "start": 14.925,
   "end": 16.1
  },
  {
   "scene": "s03",
   "i": 2,
   "seg": "body",
   "zh": "到底要攒多少？",
   "start": 16.634,
   "end": 17.44
  },
  {
   "scene": "s04",
   "i": 0,
   "seg": "body",
   "zh": "有个简单的算法，叫【4%法则】",
   "start": 17.991,
   "end": 19.99
  },
  {
   "scene": "s04",
   "i": 1,
   "seg": "body",
   "zh": "每年只花存款的【4%】",
   "start": 20.681,
   "end": 22.08
  },
  {
   "scene": "s04",
   "i": 2,
   "seg": "body",
   "zh": "钱基本就花不完",
   "start": 22.456,
   "end": 23.34
  },
  {
   "scene": "s05",
   "i": 0,
   "seg": "body",
   "zh": "反过来算",
   "start": 23.905,
   "end": 24.33
  },
  {
   "scene": "s05",
   "i": 1,
   "seg": "body",
   "zh": "一年花多少，【乘以25】",
   "start": 24.902,
   "end": 26.36
  },
  {
   "scene": "s05",
   "i": 2,
   "seg": "body",
   "zh": "就是你的【退休数字】",
   "start": 26.694,
   "end": 27.64
  },
  {
   "scene": "s06",
   "i": 0,
   "seg": "body",
   "zh": "每月5000，一年【6万】",
   "start": 28.161,
   "end": 29.55
  },
  {
   "scene": "s06",
   "i": 1,
   "seg": "body",
   "zh": "再乘以25",
   "start": 29.992,
   "end": 30.7
  },
  {
   "scene": "s06",
   "i": 2,
   "seg": "body",
   "zh": "【150万】",
   "start": 31.047,
   "end": 31.48
  },
  {
   "scene": "s07",
   "i": 0,
   "seg": "body",
   "zh": "很吓人？",
   "start": 32.131,
   "end": 32.131
  },
  {
   "scene": "s07",
   "i": 1,
   "seg": "body",
   "zh": "别急，这个公式藏着一个【好消息】",
   "start": 32.998,
   "end": 34.83
  },
  {
   "scene": "s07",
   "i": 2,
   "seg": "body",
   "zh": "花得越少，要攒的就【越少】",
   "start": 35.482,
   "end": 37.1
  },
  {
   "scene": "s08",
   "i": 0,
   "seg": "body",
   "zh": "每月少花【1000】",
   "start": 37.66,
   "end": 38.42
  },
  {
   "scene": "s08",
   "i": 1,
   "seg": "body",
   "zh": "目标直接少【30万】",
   "start": 38.731,
   "end": 39.74
  },
  {
   "scene": "s09",
   "i": 0,
   "seg": "body",
   "zh": "所以第一步不是赚更多",
   "start": 40.244,
   "end": 41.54
  },
  {
   "scene": "s09",
   "i": 1,
   "seg": "body",
   "zh": "而是先【算清楚】",
   "start": 41.877,
   "end": 42.47
  },
  {
   "scene": "s09",
   "i": 2,
   "seg": "body",
   "zh": "你一个月到底花多少钱",
   "start": 43.072,
   "end": 44.44
  },
  {
   "scene": "s10",
   "i": 0,
   "seg": "end",
   "zh": "你每月花多少？",
   "start": 45.29,
   "end": 46.125
  },
  {
   "scene": "s10",
   "i": 1,
   "seg": "end",
   "zh": "评论区算算你的【退休数字】",
   "start": 46.53,
   "end": 47.665
  },
  {
   "scene": "s10",
   "i": 2,
   "seg": "end",
   "zh": "关注阿牛",
   "start": 48.07,
   "end": 48.565
  },
  {
   "scene": "s10",
   "i": 3,
   "seg": "end",
   "zh": "一起【早日退休】！",
   "start": 48.736,
   "end": 49.415
  }
 ],
