 "lines": [
  {
   "scene": "s01",
   "i": 0,
   "seg": "open",
   "zh": "普通人，要如何才能【提前退休】？",
   "start": 0.3,
   "end": 1.915
  },
  {
   "scene": "s01",
   "i": 1,
   "seg": "open",
   "zh": "这里是阿牛退休计划，第4期",
   "start": 2.44,
   "end": 4.005
  },
  {
   "scene": "s02",
   "i": 0,
   "seg": "open",
   "zh": "本期我们要讲的是：",
   "start": 4.707,
   "end": 5.545
  },
  {
   "scene": "s02",
   "i": 1,
   "seg": "title",
   "zh": "存钱是能力，不是性格",
   "start": 8.19,
   "end": 10.12
  },
  {
   "scene": "s03",
   "i": 0,
   "seg": "body",
   "zh": "每个月都说，这次一定要存钱",
   "start": 10.915,
   "end": 12.785
  },
  {
   "scene": "s03",
   "i": 1,
   "seg": "body",
   "zh": "结果月底一看，又【月光】了",
   "start": 13.371,
   "end": 15.035
  },
  {
   "scene": "s03",
   "i": 2,
   "seg": "body",
   "zh": "然后骂自己：我就是存不住钱的人",
   "start": 15.37,
   "end": 17.525
  },
  {
   "scene": "s04",
   "i": 0,
   "seg": "body",
   "zh": "可存不下钱，真不怪你【性格】",
   "start": 18.095,
   "end": 19.865
  },
  {
   "scene": "s04",
   "i": 1,
   "seg": "body",
   "zh": "问题出在顺序上：",
   "start": 20.454,
   "end": 21.105
  },
  {
   "scene": "s04",
   "i": 2,
   "seg": "body",
   "zh": "你是先花，花剩多少才存多少",
   "start": 21.82,
   "end": 23.965
  },
  {
   "scene": "s05",
   "i": 0,
   "seg": "body",
   "zh": "先花后存，就是在跟意志力较劲",
   "start": 24.51,
   "end": 26.345
  },
  {
   "scene": "s05",
   "i": 1,
   "seg": "body",
   "zh": "可加班一天回到家",
   "start": 26.9,
   "end": 28.045
  },
  {
   "scene": "s05",
   "i": 2,
   "seg": "body",
   "zh": "谁还扛得住外卖和购物车？",
   "start": 28.539,
   "end": 30.105
  },
  {
   "scene": "s05",
   "i": 3,
   "seg": "body",
   "zh": "意志力会累，【机制】不会",
   "start": 30.45,
   "end": 31.855
  },
  {
   "scene": "s06",
   "i": 0,
   "seg": "body",
   "zh": "所以把顺序反过来：",
   "start": 32.432,
   "end": 33.235
  },
  {
   "scene": "s06",
   "i": 1,
   "seg": "body",
   "zh": "工资到账，【先存】，再花",
   "start": 33.8,
   "end": 35.575
  },
  {
   "scene": "s06",
   "i": 2,
   "seg": "body",
   "zh": "剩下的钱随便花，不用愧疚",
   "start": 36.173,
   "end": 37.795
  },
  {
   "scene": "s07",
   "i": 0,
   "seg": "body",
   "zh": "具体怎么做？",
   "start": 38.511,
   "end": 39.055
  },
  {
   "scene": "s07",
   "i": 1,
   "seg": "body",
   "zh": "在手机银行设一个【自动转账】",
   "start": 39.571,
   "end": 41.275
  },
  {
   "scene": "s07",
   "i": 2,
   "seg": "body",
   "zh": "工资到账当天，自动转走一笔",
   "start": 41.752,
   "end": 43.445
  },
  {
   "scene": "s07",
   "i": 3,
   "seg": "body",
   "zh": "转进一个不常用的账户",
   "start": 43.886,
   "end": 44.945
  },
  {
   "scene": "s08",
   "i": 0,
   "seg": "body",
   "zh": "一开始转多少？",
   "start": 45.569,
   "end": 46.274
  },
  {
   "scene": "s08",
   "i": 1,
   "seg": "body",
   "zh": "不用多，先转工资的：",
   "start": 46.74,
   "end": 47.964
  },
  {
   "scene": "s08",
   "i": 2,
   "seg": "body",
   "zh": "【10%】",
   "start": 48.154,
   "end": 48.695
  },
  {
   "scene": "s08",
   "i": 3,
   "seg": "body",
   "zh": "少到你几乎感觉不到",
   "start": 49.272,
   "end": 50.405
  },
  {
   "scene": "s09",
   "i": 0,
   "seg": "body",
   "zh": "关键是，让这笔钱【看不见】",
   "start": 51.097,
   "end": 52.085
  },
  {
   "scene": "s09",
   "i": 1,
   "seg": "body",
   "zh": "不绑支付，不开快捷付款",
   "start": 53.135,
   "end": 54.635
  },
  {
   "scene": "s09",
   "i": 2,
   "seg": "body",
   "zh": "想花还得多走好几步",
   "start": 55.18,
   "end": 56.285
  },
  {
   "scene": "s09",
   "i": 3,
   "seg": "body",
   "zh": "多数时候，你就懒得动了",
   "start": 56.827,
   "end": 58.155
  },
  {
   "scene": "s10",
   "i": 0,
   "seg": "body",
   "zh": "过两三个月，习惯了",
   "start": 58.851,
   "end": 60.065
  },
  {
   "scene": "s10",
   "i": 1,
   "seg": "body",
   "zh": "每次涨薪、发奖金",
   "start": 60.636,
   "end": 61.235
  },
  {
   "scene": "s10",
   "i": 2,
   "seg": "body",
   "zh": "就把比例往上调一点",
   "start": 61.494,
   "end": 62.665
  },
  {
   "scene": "s10",
   "i": 3,
   "seg": "body",
   "zh": "钱自动在攒，不用天天【咬牙】",
   "start": 63.809,
   "end": 65.505
  },
  {
   "scene": "s11",
   "i": 0,
   "seg": "body",
   "zh": "所以存钱从来不是性格",
   "start": 66.177,
   "end": 67.505
  },
  {
   "scene": "s11",
   "i": 1,
   "seg": "body",
   "zh": "是一个能学会的【能力】",
   "start": 68.048,
   "end": 69.075
  },
  {
   "scene": "s11",
   "i": 2,
   "seg": "body",
   "zh": "设一次，以后每个月都在帮你存",
   "start": 69.58,
   "end": 71.345
  },
  {
   "scene": "s12",
   "i": 0,
   "seg": "body",
   "zh": "这周就去做一件事：",
   "start": 72.038,
   "end": 72.805
  },
  {
   "scene": "s12",
   "i": 1,
   "seg": "body",
   "zh": "打开手机银行，设好【发薪日自动转账】",
   "start": 73.399,
   "end": 75.545
  },
  {
   "scene": "s12",
   "i": 2,
   "seg": "body",
   "zh": "先转10%，下个月就能看到",
   "start": 76.154,
   "end": 78.019
  },
  {
   "scene": "s13",
   "i": 0,
   "seg": "body",
   "zh": "发工资那天，你的钱先去哪了？",
   "start": 78.701,
   "end": 80.429
  },
  {
   "scene": "s13",
   "i": 1,
   "seg": "body",
   "zh": "留言告诉阿牛",
   "start": 80.933,
   "end": 81.539
  },
  {
   "scene": "s13",
   "i": 2,
   "seg": "end",
   "zh": "关注阿牛，一起【早日退休】！",
   "start": 82.389,
   "end": 83.634
  }
 ],
