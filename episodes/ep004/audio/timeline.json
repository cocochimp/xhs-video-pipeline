 "lines": [
  {
   "scene": "s01",
   "i": 0,
   "seg": "open",
   "zh": "普通人，要如何才能【提前退休】？",
   "start": 0.3,
   "end": 1.805
  },
  {
   "scene": "s01",
   "i": 1,
   "seg": "open",
   "zh": "这里是阿牛退休计划，第4期",
   "start": 2.284,
   "end": 3.715
  },
  {
   "scene": "s02",
   "i": 0,
   "seg": "open",
   "zh": "本期我们要讲的是：",
   "start": 4.544,
   "end": 5.335
  },
  {
   "scene": "s02",
   "i": 1,
   "seg": "title",
   "zh": "存钱是能力，不是性格",
   "start": 7.98,
   "end": 9.91
  },
  {
   "scene": "s03",
   "i": 0,
   "seg": "body",
   "zh": "每个月都说，这次一定要存钱",
   "start": 10.705,
   "end": 12.455
  },
  {
   "scene": "s03",
   "i": 1,
   "seg": "body",
   "zh": "结果月底一看，又【月光】了",
   "start": 13.008,
   "end": 14.465
  },
  {
   "scene": "s03",
   "i": 2,
   "seg": "body",
   "zh": "然后骂自己：我就是存不住钱的人",
   "start": 14.948,
   "end": 16.875
  },
  {
   "scene": "s04",
   "i": 0,
   "seg": "body",
   "zh": "可存不下钱，真不怪你【性格】",
   "start": 17.553,
   "end": 19.145
  },
  {
   "scene": "s04",
   "i": 1,
   "seg": "body",
   "zh": "问题出在顺序上：",
   "start": 19.725,
   "end": 20.495
  },
  {
   "scene": "s04",
   "i": 2,
   "seg": "body",
   "zh": "你是先花，花剩多少才存多少",
   "start": 21.09,
   "end": 23.135
  },
  {
   "scene": "s05",
   "i": 0,
   "seg": "body",
   "zh": "先花后存，就是在跟意志力较劲",
   "start": 23.771,
   "end": 25.535
  },
  {
   "scene": "s05",
   "i": 1,
   "seg": "body",
   "zh": "可加班一天回到家",
   "start": 26.189,
   "end": 27.175
  },
  {
   "scene": "s05",
   "i": 2,
   "seg": "body",
   "zh": "谁还扛得住外卖和购物车？",
   "start": 27.428,
   "end": 28.755
  },
  {
   "scene": "s05",
   "i": 3,
   "seg": "body",
   "zh": "意志力会累，【机制】不会",
   "start": 29.351,
   "end": 30.555
  },
  {
   "scene": "s06",
   "i": 0,
   "seg": "body",
   "zh": "所以把顺序反过来：",
   "start": 31.266,
   "end": 32.135
  },
  {
   "scene": "s06",
   "i": 1,
   "seg": "body",
   "zh": "工资到账，【先存】，再花",
   "start": 32.75,
   "end": 34.265
  },
  {
   "scene": "s06",
   "i": 2,
   "seg": "body",
   "zh": "剩下的钱随便花，不用愧疚",
   "start": 34.87,
   "end": 36.375
  },
  {
   "scene": "s07",
   "i": 0,
   "seg": "body",
   "zh": "具体怎么做？",
   "start": 37.41,
   "end": 37.945
  },
  {
   "scene": "s07",
   "i": 1,
   "seg": "body",
   "zh": "在手机银行设一个【自动转账】",
   "start": 38.071,
   "end": 39.745
  },
  {
   "scene": "s07",
   "i": 2,
   "seg": "body",
   "zh": "工资到账当天，自动转走一笔",
   "start": 40.268,
   "end": 41.835
  },
  {
   "scene": "s07",
   "i": 3,
   "seg": "body",
   "zh": "转进一个不常用的账户",
   "start": 42.228,
   "end": 43.285
  },
  {
   "scene": "s08",
   "i": 0,
   "seg": "body",
   "zh": "一开始转多少？",
   "start": 43.955,
   "end": 44.66
  },
  {
   "scene": "s08",
   "i": 1,
   "seg": "body",
   "zh": "不用多，先转工资的：",
   "start": 45.082,
   "end": 46.37
  },
  {
   "scene": "s08",
   "i": 2,
   "seg": "body",
   "zh": "【10%】",
   "start": 46.451,
   "end": 47.021
  },
  {
   "scene": "s08",
   "i": 3,
   "seg": "body",
   "zh": "少到你几乎感觉不到",
   "start": 47.555,
   "end": 48.601
  },
  {
   "scene": "s09",
   "i": 0,
   "seg": "body",
   "zh": "关键是，让这笔钱【看不见】",
   "start": 49.265,
   "end": 50.591
  },
  {
   "scene": "s09",
   "i": 1,
   "seg": "body",
   "zh": "不绑支付，不开快捷付款",
   "start": 51.176,
   "end": 52.501
  },
  {
   "scene": "s09",
   "i": 2,
   "seg": "body",
   "zh": "想花还得多走好几步",
   "start": 52.988,
   "end": 54.121
  },
  {
   "scene": "s09",
   "i": 3,
   "seg": "body",
   "zh": "多数时候，你就懒得动了",
   "start": 54.631,
   "end": 55.851
  },
  {
   "scene": "s10",
   "i": 0,
   "seg": "body",
   "zh": "过两三个月，习惯了",
   "start": 56.621,
   "end": 57.721
  },
  {
   "scene": "s10",
   "i": 1,
   "seg": "body",
   "zh": "每次涨薪、发奖金",
   "start": 58.273,
   "end": 59.311
  },
  {
   "scene": "s10",
   "i": 2,
   "seg": "body",
   "zh": "就把比例往上调一点",
   "start": 59.676,
   "end": 60.631
  },
  {
   "scene": "s10",
   "i": 3,
   "seg": "body",
   "zh": "钱自动在攒，不用天天【咬牙】",
   "start": 61.147,
   "end": 62.701
  },
  {
   "scene": "s11",
   "i": 0,
   "seg": "body",
   "zh": "所以存钱从来不是性格",
   "start": 63.389,
   "end": 64.751
  },
  {
   "scene": "s11",
   "i": 1,
   "seg": "body",
   "zh": "是一个能学会的【能力】",
   "start": 65.218,
   "end": 66.201
  },
  {
   "scene": "s11",
   "i": 2,
   "seg": "body",
   "zh": "设一次，以后每个月都在帮你存",
   "start": 66.776,
   "end": 68.371
  },
  {
   "scene": "s12",
   "i": 0,
   "seg": "body",
   "zh": "这周就去做一件事：",
   "start": 69.101,
   "end": 69.871
  },
  {
   "scene": "s12",
   "i": 1,
   "seg": "body",
   "zh": "打开手机银行，设好【发薪日自动转账】",
   "start": 70.383,
   "end": 72.451
  },
  {
   "scene": "s12",
   "i": 2,
   "seg": "body",
   "zh": "先转10%，下个月就能看到",
   "start": 72.956,
   "end": 74.751
  },
  {
   "scene": "s13",
   "i": 0,
   "seg": "body",
   "zh": "发工资那天，你的钱先去哪了？",
   "start": 75.394,
   "end": 76.939
  },
  {
   "scene": "s13",
   "i": 1,
   "seg": "body",
   "zh": "留言告诉阿牛",
   "start": 77.434,
   "end": 77.999
  },
  {
   "scene": "s13",
   "i": 2,
   "seg": "end",
   "zh": "关注阿牛，一起【早日退休】！",
   "start": 78.849,
   "end": 80.094
  }
 ],
