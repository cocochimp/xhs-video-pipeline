 "lines": [
  {
   "scene": "s01",
   "i": 0,
   "seg": "open",
   "zh": "普通人，要如何才能【提前退休】？",
   "start": 0.355,
   "end": 1.895
  },
  {
   "scene": "s01",
   "i": 1,
   "seg": "open",
   "zh": "这里是阿牛退休计划，第3期",
   "start": 2.224,
   "end": 3.795
  },
  {
   "scene": "s02",
   "i": 0,
   "seg": "open",
   "zh": "本期我们要讲的是：",
   "start": 4.435,
   "end": 5.315
  },
  {
   "scene": "s02",
   "i": 1,
   "seg": "title",
   "zh": "除了打工，普通人还能靠这5件事搞钱",
   "start": 7.915,
   "end": 10.65
  },
  {
   "scene": "s03",
   "i": 0,
   "seg": "body",
   "zh": "天天加班，收入却只有【一份】工资",
   "start": 11.4,
   "end": 13.815
  },
  {
   "scene": "s03",
   "i": 1,
   "seg": "body",
   "zh": "月光不说，一被裁，收入直接【归零】",
   "start": 14.36,
   "end": 17.125
  },
  {
   "scene": "s03",
   "i": 2,
   "seg": "body",
   "zh": "除了打工，普通人还能靠什么赚钱？",
   "start": 17.627,
   "end": 19.645
  },
  {
   "scene": "s04",
   "i": 0,
   "seg": "body",
   "zh": "打工，是把【时间】卖给一个老板",
   "start": 20.42,
   "end": 22.175
  },
  {
   "scene": "s04",
   "i": 1,
   "seg": "body",
   "zh": "下面这5件事，是给自己多开【一条路】",
   "start": 22.836,
   "end": 25.185
  },
  {
   "scene": "s04",
   "i": 2,
   "seg": "body",
   "zh": "从门槛最低的说起",
   "start": 25.719,
   "end": 26.725
  },
  {
   "scene": "s05",
   "i": 0,
   "seg": "body",
   "zh": "第一件，【卖技能】",
   "start": 27.385,
   "end": 28.405
  },
  {
   "scene": "s05",
   "i": 1,
   "seg": "body",
   "zh": "做PPT、写文案、修图、剪视频",
   "start": 28.912,
   "end": 31.345
  },
  {
   "scene": "s05",
   "i": 2,
   "seg": "body",
   "zh": "这些你上班天天在用",
   "start": 31.867,
   "end": 32.895
  },
  {
   "scene": "s05",
   "i": 3,
   "seg": "body",
   "zh": "挂到闲鱼和朋友圈，按单收钱",
   "start": 33.372,
   "end": 35.035
  },
  {
   "scene": "s05",
   "i": 4,
   "seg": "body",
   "zh": "不用从零学，最快见到【第一笔钱】",
   "start": 35.518,
   "end": 37.645
  },
  {
   "scene": "s06",
   "i": 0,
   "seg": "body",
   "zh": "第二件，【做内容】",
   "start": 38.318,
   "end": 39.295
  },
  {
   "scene": "s06",
   "i": 1,
   "seg": "body",
   "zh": "把工作里的经验，写成笔记、拍成视频",
   "start": 39.859,
   "end": 42.125
  },
  {
   "scene": "s06",
   "i": 2,
   "seg": "body",
   "zh": "起步慢，但一条内容发出去",
   "start": 42.613,
   "end": 44.415
  },
  {
   "scene": "s06",
   "i": 3,
   "seg": "body",
   "zh": "能被人一直刷到",
   "start": 44.774,
   "end": 45.565
  },
  {
   "scene": "s06",
   "i": 4,
   "seg": "body",
   "zh": "攒下的作品和粉丝，就是你的【资产】",
   "start": 46.061,
   "end": 48.075
  },
  {
   "scene": "s07",
   "i": 0,
   "seg": "body",
   "zh": "第三件，【倒二手】",
   "start": 48.755,
   "end": 49.786
  },
  {
   "scene": "s07",
   "i": 1,
   "seg": "body",
   "zh": "先把家里的闲置卖掉",
   "start": 50.357,
   "end": 51.366
  },
  {
   "scene": "s07",
   "i": 2,
   "seg": "body",
   "zh": "摸清怎么定价、怎么发货",
   "start": 51.809,
   "end": 53.156
  },
  {
   "scene": "s07",
   "i": 3,
   "seg": "body",
   "zh": "再挑一个你懂的品类，比如数码、书、母婴",
   "start": 53.628,
   "end": 56.376
  },
  {
   "scene": "s07",
   "i": 4,
   "seg": "body",
   "zh": "低价收、合理卖，赚的是【懂行】的钱",
   "start": 56.884,
   "end": 59.366
  },
  {
   "scene": "s08",
   "i": 0,
   "seg": "body",
   "zh": "第四件，【配资产】",
   "start": 59.991,
   "end": 61.046
  },
  {
   "scene": "s08",
   "i": 1,
   "seg": "body",
   "zh": "存下来的钱，别只躺在活期里",
   "start": 61.66,
   "end": 63.536
  },
  {
   "scene": "s08",
   "i": 2,
   "seg": "body",
   "zh": "放进货币基金、指数基金，让钱替你干活",
   "start": 64.086,
   "end": 66.726
  },
  {
   "scene": "s08",
   "i": 3,
   "seg": "body",
   "zh": "前提是先留够应急金，【不借钱】去投",
   "start": 67.261,
   "end": 69.406
  },
  {
   "scene": "s09",
   "i": 0,
   "seg": "body",
   "zh": "第五件，【用人脉】",
   "start": 70.01,
   "end": 71.016
  },
  {
   "scene": "s09",
   "i": 1,
   "seg": "body",
   "zh": "你认识一个缺设计的老板",
   "start": 71.625,
   "end": 72.726
  },
  {
   "scene": "s09",
   "i": 2,
   "seg": "body",
   "zh": "又认识一个会设计的朋友",
   "start": 73.129,
   "end": 74.116
  },
  {
   "scene": "s09",
   "i": 3,
   "seg": "body",
   "zh": "帮他们搭上线，收一份介绍费",
   "start": 74.696,
   "end": 76.246
  },
  {
   "scene": "s09",
   "i": 4,
   "seg": "body",
   "zh": "信任本身就【值钱】",
   "start": 76.69,
   "end": 77.546
  },
  {
   "scene": "s09",
   "i": 5,
   "seg": "body",
   "zh": "前提是，你平时做事【靠谱】",
   "start": 78.038,
   "end": 79.544
  },
  {
   "scene": "s10",
   "i": 0,
   "seg": "body",
   "zh": "5件事不用全做，按你手里有什么来选",
   "start": 80.253,
   "end": 82.254
  },
  {
   "scene": "s10",
   "i": 1,
   "seg": "body",
   "zh": "有手艺卖技能，有耐心做内容",
   "start": 82.95,
   "end": 85.074
  },
  {
   "scene": "s10",
   "i": 2,
   "seg": "body",
   "zh": "懂货就倒二手",
   "start": 85.543,
   "end": 86.344
  },
  {
   "scene": "s10",
   "i": 3,
   "seg": "body",
   "zh": "有存款配资产，圈子广就用人脉",
   "start": 86.929,
   "end": 89.044
  },
  {
   "scene": "s11",
   "i": 0,
   "seg": "body",
   "zh": "不管选哪条，记住一句话",
   "start": 89.629,
   "end": 91.014
  },
  {
   "scene": "s11",
   "i": 1,
   "seg": "body",
   "zh": "先让你交钱、才教你赚钱的，【别碰】",
   "start": 91.57,
   "end": 93.874
  },
  {
   "scene": "s12",
   "i": 0,
   "seg": "body",
   "zh": "第一步，别想着一夜暴富",
   "start": 94.528,
   "end": 95.924
  },
  {
   "scene": "s12",
   "i": 1,
   "seg": "body",
   "zh": "先挑一件，目标定成每月多赚【1000块】",
   "start": 96.381,
   "end": 98.724
  },
  {
   "scene": "s12",
   "i": 2,
   "seg": "body",
   "zh": "这周就把你的【第一单】挂出去",
   "start": 99.207,
   "end": 100.424
  },
  {
   "scene": "s13",
   "i": 0,
   "seg": "body",
   "zh": "你想先试【哪一件】？留言告诉阿牛",
   "start": 101.059,
   "end": 102.633
  },
  {
   "scene": "s13",
   "i": 1,
   "seg": "end",
   "zh": "关注阿牛，一起【早日退休】！",
   "start": 103.483,
   "end": 105.108
  }
 ],
