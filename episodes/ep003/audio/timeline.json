 "lines": [
  {
   "scene": "s01",
   "i": 0,
   "seg": "open",
   "zh": "普通人，要如何才能【提前退休】？",
   "start": 0.3,
   "end": 1.845
  },
  {
   "scene": "s01",
   "i": 1,
   "seg": "open",
   "zh": "这里是阿牛退休计划，第3期",
   "start": 2.556,
   "end": 4.175
  },
  {
   "scene": "s02",
   "i": 0,
   "seg": "open",
   "zh": "本期我们要讲的是：",
   "start": 5.247,
   "end": 6.245
  },
  {
   "scene": "s02",
   "i": 1,
   "seg": "title",
   "zh": "除了打工，普通人还能靠这5件事搞钱",
   "start": 8.845,
   "end": 11.58
  },
  {
   "scene": "s03",
   "i": 0,
   "seg": "body",
   "zh": "天天加班，收入却只有【一份】工资",
   "start": 12.33,
   "end": 14.475
  },
  {
   "scene": "s03",
   "i": 1,
   "seg": "body",
   "zh": "月光不说，一被裁，收入直接【归零】",
   "start": 15.282,
   "end": 17.915
  },
  {
   "scene": "s03",
   "i": 2,
   "seg": "body",
   "zh": "除了打工，普通人还能靠什么赚钱？",
   "start": 18.682,
   "end": 20.855
  },
  {
   "scene": "s04",
   "i": 0,
   "seg": "body",
   "zh": "打工，是把【时间】卖给一个老板",
   "start": 22.01,
   "end": 23.685
  },
  {
   "scene": "s04",
   "i": 1,
   "seg": "body",
   "zh": "下面这5件事，是给自己多开【一条路】",
   "start": 24.823,
   "end": 27.135
  },
  {
   "scene": "s04",
   "i": 2,
   "seg": "body",
   "zh": "从门槛最低的说起",
   "start": 27.921,
   "end": 28.985
  },
  {
   "scene": "s05",
   "i": 0,
   "seg": "body",
   "zh": "第一件，【卖技能】",
   "start": 30.055,
   "end": 31.105
  },
  {
   "scene": "s05",
   "i": 1,
   "seg": "body",
   "zh": "做PPT、写文案、修图、剪视频",
   "start": 31.743,
   "end": 34.265
  },
  {
   "scene": "s05",
   "i": 2,
   "seg": "body",
   "zh": "这些你上班天天在用",
   "start": 35.008,
   "end": 36.185
  },
  {
   "scene": "s05",
   "i": 3,
   "seg": "body",
   "zh": "挂到闲鱼和朋友圈，按单收钱",
   "start": 36.847,
   "end": 38.565
  },
  {
   "scene": "s05",
   "i": 4,
   "seg": "body",
   "zh": "不用从零学，最快见到【第一笔钱】",
   "start": 39.372,
   "end": 41.675
  },
  {
   "scene": "s06",
   "i": 0,
   "seg": "body",
   "zh": "第二件，【做内容】",
   "start": 42.727,
   "end": 43.725
  },
  {
   "scene": "s06",
   "i": 1,
   "seg": "body",
   "zh": "把工作里的经验，写成笔记、拍成视频",
   "start": 44.508,
   "end": 46.945
  },
  {
   "scene": "s06",
   "i": 2,
   "seg": "body",
   "zh": "起步慢，但一条内容发出去",
   "start": 47.675,
   "end": 49.525
  },
  {
   "scene": "s06",
   "i": 3,
   "seg": "body",
   "zh": "能被人一直刷到",
   "start": 50.061,
   "end": 50.875
  },
  {
   "scene": "s06",
   "i": 4,
   "seg": "body",
   "zh": "攒下的作品和粉丝，就是你的【资产】",
   "start": 51.565,
   "end": 53.695
  },
  {
   "scene": "s07",
   "i": 0,
   "seg": "body",
   "zh": "第三件，【倒二手】",
   "start": 54.829,
   "end": 55.92
  },
  {
   "scene": "s07",
   "i": 1,
   "seg": "body",
   "zh": "先把家里的闲置卖掉",
   "start": 56.635,
   "end": 57.761
  },
  {
   "scene": "s07",
   "i": 2,
   "seg": "body",
   "zh": "摸清怎么定价、怎么发货",
   "start": 58.415,
   "end": 59.871
  },
  {
   "scene": "s07",
   "i": 3,
   "seg": "body",
   "zh": "再挑一个你懂的品类，比如数码、书、母婴",
   "start": 60.556,
   "end": 63.851
  },
  {
   "scene": "s07",
   "i": 4,
   "seg": "body",
   "zh": "低价收、合理卖，赚的是【懂行】的钱",
   "start": 64.528,
   "end": 67.121
  },
  {
   "scene": "s08",
   "i": 0,
   "seg": "body",
   "zh": "第四件，【配资产】",
   "start": 68.172,
   "end": 69.061
  },
  {
   "scene": "s08",
   "i": 1,
   "seg": "body",
   "zh": "存下来的钱，别只躺在活期里",
   "start": 70.13,
   "end": 72.171
  },
  {
   "scene": "s08",
   "i": 2,
   "seg": "body",
   "zh": "放进货币基金、指数基金，让钱替你干活",
   "start": 72.894,
   "end": 75.761
  },
  {
   "scene": "s08",
   "i": 3,
   "seg": "body",
   "zh": "前提是先留够应急金，【不借钱】去投",
   "start": 76.518,
   "end": 78.911
  },
  {
   "scene": "s09",
   "i": 0,
   "seg": "body",
   "zh": "第五件，【用人脉】",
   "start": 79.97,
   "end": 81.05
  },
  {
   "scene": "s09",
   "i": 1,
   "seg": "body",
   "zh": "你认识一个缺设计的老板",
   "start": 81.874,
   "end": 83.049
  },
  {
   "scene": "s09",
   "i": 2,
   "seg": "body",
   "zh": "又认识一个会设计的朋友",
   "start": 83.627,
   "end": 84.669
  },
  {
   "scene": "s09",
   "i": 3,
   "seg": "body",
   "zh": "帮他们搭上线，收一份介绍费",
   "start": 85.419,
   "end": 86.999
  },
  {
   "scene": "s09",
   "i": 4,
   "seg": "body",
   "zh": "信任本身就【值钱】",
   "start": 87.683,
   "end": 88.579
  },
  {
   "scene": "s09",
   "i": 5,
   "seg": "body",
   "zh": "前提是，你平时做事【靠谱】",
   "start": 89.317,
   "end": 90.589
  },
  {
   "scene": "s10",
   "i": 0,
   "seg": "body",
   "zh": "5件事不用全做，按你手里有什么来选",
   "start": 91.968,
   "end": 94.329
  },
  {
   "scene": "s10",
   "i": 1,
   "seg": "body",
   "zh": "有手艺卖技能，有耐心做内容",
   "start": 95.173,
   "end": 97.489
  },
  {
   "scene": "s10",
   "i": 2,
   "seg": "body",
   "zh": "懂货就倒二手",
   "start": 98.129,
   "end": 98.959
  },
  {
   "scene": "s10",
   "i": 3,
   "seg": "body",
   "zh": "有存款配资产，圈子广就用人脉",
   "start": 99.554,
   "end": 101.759
  },
  {
   "scene": "s11",
   "i": 0,
   "seg": "body",
   "zh": "不管选哪条，记住一句话",
   "start": 102.756,
   "end": 104.259
  },
  {
   "scene": "s11",
   "i": 1,
   "seg": "body",
   "zh": "先让你交钱、才教你赚钱的，【别碰】",
   "start": 104.993,
   "end": 107.459
  },
  {
   "scene": "s12",
   "i": 0,
   "seg": "body",
   "zh": "第一步，别想着一夜暴富",
   "start": 108.564,
   "end": 109.919
  },
  {
   "scene": "s12",
   "i": 1,
   "seg": "body",
   "zh": "先挑一件，目标定成每月多赚【1000块】",
   "start": 110.628,
   "end": 113.089
  },
  {
   "scene": "s12",
   "i": 2,
   "seg": "body",
   "zh": "这周就把你的【第一单】挂出去",
   "start": 113.881,
   "end": 115.099
  },
  {
   "scene": "s13",
   "i": 0,
   "seg": "body",
   "zh": "你想先试【哪一件】？留言告诉阿牛",
   "start": 116.065,
   "end": 117.779
  },
  {
   "scene": "s13",
   "i": 1,
   "seg": "end",
   "zh": "关注阿牛，一起【早日退休】！",
   "start": 118.629,
   "end": 120.254
  }
 ],
